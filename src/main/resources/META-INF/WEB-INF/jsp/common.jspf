<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="toolbar"><a href="<c:url value='/'/>">Trang chủ</a><c:choose><c:when test="${not empty sessionScope.account}"><a href="<c:url value='/dashboard'/>">Dashboard</a><c:if test="${sessionScope.account.roleid == 1}"><a href="<c:url value='/admin/category'/>">Danh mục</a><a href="<c:url value='/admin/user'/>">Người dùng</a></c:if><form method="post" action="<c:url value='/logout'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button type="submit">Đăng xuất</button></form></c:when><c:otherwise><a href="<c:url value='/login'/>">Đăng nhập</a><a href="<c:url value='/register'/>">Đăng ký</a></c:otherwise></c:choose></nav>
