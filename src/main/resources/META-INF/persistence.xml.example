    <persistence-unit name="jpa-hibernate-mysql">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.nguyenduchoc.bt5.entity.User</class>
        <class>com.nguyenduchoc.bt5.entity.Category</class>
        <class>com.nguyenduchoc.bt5.entity.Product</class>
        <class>com.nguyenduchoc.bt5.entity.RememberToken</class>
        <class>com.nguyenduchoc.bt5.entity.OtpToken</class>
        <class>com.nguyenduchoc.bt5.entity.ProfileEmailChange</class>
        <class>com.nguyenduchoc.bt5.entity.Video</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:1433;encrypt=true;trustServerCertificate=true;databaseName=MVC_24162039" />
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.microsoft.sqlserver.jdbc.SQLServerDriver" />
            <property name="jakarta.persistence.jdbc.user" value="sa" />
            <property name="jakarta.persistence.jdbc.password" value="" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <!-- Cấu trúc được quản lý bằng database/schema.sql để migration có thể kiểm soát constraint. -->
            <property name="hibernate.hbm2ddl.auto" value="none" />
        </properties>
    </persistence-unit>
</persistence>
